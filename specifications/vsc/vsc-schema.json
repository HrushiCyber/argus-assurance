{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus-assurance.org/specifications/vsc/v1/vsc-schema.json",
  "title": "ARGUS Verifiable System Claim",
  "description": "Schema for bounded, machine-verifiable claims about properties of digital systems.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "claim_type",
    "subject",
    "property",
    "scope",
    "assumptions",
    "evidence",
    "validation",
    "proof",
    "validity",
    "issuer",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "vsc-1.0"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "claim_type": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "property": {
      "$ref": "#/$defs/property"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "proof": {
      "$ref": "#/$defs/proof"
    },
    "validity": {
      "$ref": "#/$defs/validity"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      },
      "default": []
    },
    "issuer": {
      "$ref": "#/$defs/issuer"
    },
    "trust": {
      "$ref": "#/$defs/trust"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "subject_type"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_type": {
          "type": "string",
          "enum": [
            "application",
            "cloud_workload",
            "identity",
            "data_system",
            "ai_agent",
            "supplier",
            "cyber_physical_system",
            "software_artifact",
            "device",
            "service",
            "other"
          ]
        },
        "identity_method": {
          "type": "string",
          "minLength": 1
        },
        "identity_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property_id",
        "description"
      ],
      "properties": {
        "property_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included"
      ],
      "properties": {
        "included": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "environment": {
          "type": "string"
        }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assumption_id",
        "description",
        "status"
      ],
      "properties": {
        "assumption_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "satisfied",
            "unsatisfied",
            "unknown"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_type",
        "content_digest",
        "observed_at"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_type": {
          "type": "string",
          "enum": [
            "runtime_telemetry",
            "remote_attestation",
            "software_provenance",
            "formal_proof",
            "validation_execution",
            "physical_sensor",
            "policy_evaluation",
            "other"
          ]
        },
        "content_digest": {
          "$ref": "#/$defs/digest"
        },
        "provenance_digest": {
          "$ref": "#/$defs/digest"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "location": {
          "type": "string"
        },
        "external_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation_id",
        "method",
        "performed_at",
        "result"
      ],
      "properties": {
        "validation_id": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "method_version": {
          "type": "string"
        },
        "performed_at": {
          "type": "string",
          "format": "date-time"
        },
        "result": {
          "type": "string",
          "enum": [
            "satisfied",
            "failed",
            "inconclusive"
          ]
        },
        "verifier_reference": {
          "type": "string"
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_id",
        "obligations"
      ],
      "properties": {
        "proof_id": {
          "type": "string",
          "minLength": 1
        },
        "obligations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/proof_obligation"
          }
        },
        "falsification": {
          "$ref": "#/$defs/falsification"
        }
      }
    },
    "proof_obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_id",
        "description",
        "status"
      ],
      "properties": {
        "obligation_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "satisfied",
            "failed",
            "unknown",
            "not_applicable"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "falsification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_run",
            "inconclusive"
          ]
        },
        "method": {
          "type": "string"
        },
        "tested_at": {
          "type": "string",
          "format": "date-time"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issued_at"
      ],
      "properties": {
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "freshness_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependency_id",
        "dependency_type",
        "content_digest"
      ],
      "properties": {
        "dependency_id": {
          "type": "string",
          "minLength": 1
        },
        "dependency_type": {
          "type": "string",
          "minLength": 1
        },
        "content_digest": {
          "$ref": "#/$defs/digest"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer_id",
        "trust_domain"
      ],
      "properties": {
        "issuer_id": {
          "type": "string",
          "minLength": 1
        },
        "trust_domain": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trust_anchor_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "transparency_reference": {
          "type": "string"
        },
        "revocation_reference": {
          "type": "string"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "canonicalization": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "sha-256",
            "sha-384",
            "sha-512"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]+$",
          "minLength": 1
        }
      }
    }
  }
}
